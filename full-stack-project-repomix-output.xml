 * Auto-dismisses after 4 seconds
 */
export function Toast({ message, type = 'success', onDismiss = () => {} }) {
  useEffect(() => {
    const timer = setTimeout(onDismiss, 4000)
    return () => clearTimeout(timer)
  }, [onDismiss])

  let bgColor = 'bg-green-50'
  let textColor = 'text-green-800'
  let borderColor = 'border-green-200'
  let Icon = CheckCircle

  if (type === 'error') {
    bgColor = 'bg-red-50'
    textColor = 'text-red-800'
    borderColor = 'border-red-200'
    Icon = XCircle
  } else if (type === 'warning') {
    bgColor = 'bg-yellow-50'
    textColor = 'text-yellow-800'
    borderColor = 'border-yellow-200'
    Icon = AlertCircle
  }

  return (
    <div className={`fixed bottom-4 right-4 flex items-center gap-3 px-4 py-3 border rounded-lg ${bgColor} ${textColor} ${borderColor} shadow-lg animate-in fade-in slide-in-from-bottom-4 duration-300`}>
      <Icon className="w-5 h-5 flex-shrink-0" />
      <p className="text-sm font-medium">{message}</p>
    </div>
  )
}

/**
 * Toast container for managing multiple toasts
 */
export function ToastContainer({ toasts, onDismiss }) {
  return (
    <div className="fixed bottom-4 right-4 flex flex-col gap-3 pointer-events-none">
      {toasts.map((toast) => (
        <div key={toast.id} className="pointer-events-auto">
          <Toast
            message={toast.message}
            type={toast.type}
            onDismiss={() => onDismiss(toast.id)}
          />
        </div>
      ))}
    </div>
  )
}
</file>

<file path="packages/admin/src/hooks/useAuth.js">
import { useEffect, useState } from 'react'
import apiClient from '../lib/api'

const TOKEN_KEY = 'hoh_admin_token'
const USER_KEY = 'hoh_admin_user'

function readStoredUser() {
  try {
    const raw = localStorage.getItem(USER_KEY)
    return raw ? JSON.parse(raw) : null
  } catch {
    return null
  }
}

export function useAuth() {
  const [token, setToken] = useState(localStorage.getItem(TOKEN_KEY) || '')
  const [user, setUser] = useState(readStoredUser())
  const [ready, setReady] = useState(false)

  useEffect(() => {
    let cancelled = false

    async function bootstrap() {
      if (!token) {
        if (!cancelled) setReady(true)
        return
      }

      try {
        const result = await apiClient.get('/api/admin/me')
        if (!cancelled) {
          setUser(result.data.user)
          localStorage.setItem(USER_KEY, JSON.stringify(result.data.user))
        }
      } catch {
        if (!cancelled) {
          setToken('')
          setUser(null)
          localStorage.removeItem(TOKEN_KEY)
          localStorage.removeItem(USER_KEY)
        }
      } finally {
        if (!cancelled) setReady(true)
      }
    }

    bootstrap()

    return () => {
      cancelled = true
    }
  }, [token])

  async function login(email, password) {
    const result = await apiClient.post('/api/admin/login', { email, password })

    setToken(result.data.token)
    setUser(result.data.user)
    localStorage.setItem(TOKEN_KEY, result.data.token)
    localStorage.setItem(USER_KEY, JSON.stringify(result.data.user))

    return result.data
  }

  function logout() {
    setToken('')
    setUser(null)
    localStorage.removeItem(TOKEN_KEY)
    localStorage.removeItem(USER_KEY)
  }

  return {
    token,
    user,
    ready,
    isAuthenticated: Boolean(token),
    login,
    logout,
  }
}
