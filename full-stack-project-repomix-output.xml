<file path="packages/admin/src/pages/ProgramsEditor.jsx">
import { useState, useEffect } from 'react'
import { request } from '../lib/api'
import BilingualField from '../components/BilingualField'
import ImageUploader from '../components/ImageUploader'
import { Trash2, Plus, GripVertical, ArrowUp, ArrowDown, AlertCircle } from 'lucide-react'
import { Toast } from '../components/Toast'
import { ConfirmDialog } from '../components/ConfirmDialog'
import { ErrorMessage } from '../components/ErrorMessage'
import { LoadingSpinner } from '../components/LoadingSpinner'

export default function ProgramsEditor() {
  const [programs, setPrograms] = useState([])
  const [loading, setLoading] = useState(false)
  const [initialLoading, setInitialLoading] = useState(true)
  const [editingId, setEditingId] = useState(null)
  const [showAddForm, setShowAddForm] = useState(false)
  const [submitting, setSubmitting] = useState(false)
  const [toast, setToast] = useState(null)
  const [error, setError] = useState(null)
  const [deleteConfirm, setDeleteConfirm] = useState({ isOpen: false, programId: null })
  const [formData, setFormData] = useState({
    slug: '',
    titleEn: '',
    titleBn: '',
    categoryEn: '',
    categoryBn: '',
    descriptionEn: '',
    descriptionBn: '',
    highlightEn: '',
    highlightBn: '',
    image: null,
    imageUrl: '',
  })
  const [formErrors, setFormErrors] = useState({})
  const [reordering, setReordering] = useState(false)

  useEffect(() => {
    fetchPrograms()
  }, [])

  const showToast = (message, type = 'success') => {
    setToast({ message, type })
  }

  async function fetchPrograms() {
    try {
      setInitialLoading(true)
      setError(null)
      const res = await request('GET', '/api/admin/programs')
      setPrograms(res.items || [])
    } catch (err) {
      const errorMsg = 'Failed to fetch programs: ' + err.message
      setError(errorMsg)
      showToast(errorMsg, 'error')
    } finally {
      setInitialLoading(false)
    }
  }

  const validateForm = () => {
    const errors = {}
    
    if (!formData.slug.trim()) {
      errors.slug = 'Slug is required'
    } else if (!/^[a-z0-9-]+$/.test(formData.slug)) {
      errors.slug = 'Slug must only contain lowercase letters, numbers, and hyphens'
    }

    if (!formData.titleEn.trim()) {
      errors.titleEn = 'English title is required'
    } else if (formData.titleEn.length > 200) {
      errors.titleEn = 'English title must be at most 200 characters'
    }

    if (formData.titleBn && formData.titleBn.length > 200) {
      errors.titleBn = 'Bengali title must be at most 200 characters'
    }

    if (formData.categoryEn && formData.categoryEn.length > 100) {
      errors.categoryEn = 'English category must be at most 100 characters'
    }

    if (formData.categoryBn && formData.categoryBn.length > 100) {
      errors.categoryBn = 'Bengali category must be at most 100 characters'
    }

    if (formData.descriptionEn && formData.descriptionEn.length > 500) {
      errors.descriptionEn = 'English description must be at most 500 characters'
    }

    if (formData.descriptionBn && formData.descriptionBn.length > 500) {
      errors.descriptionBn = 'Bengali description must be at most 500 characters'
    }

    if (!editingId && !formData.image) {
      errors.image = 'Program image is required'
    }

    return errors
  }

  function resetForm() {
    setFormData({
      slug: '',
      titleEn: '',
      titleBn: '',
      categoryEn: '',
      categoryBn: '',
      descriptionEn: '',
      descriptionBn: '',
      highlightEn: '',
      highlightBn: '',
      image: null,
      imageUrl: '',
    })
    setEditingId(null)
    setFormErrors({})
  }

  function editProgram(prog) {
    setFormData({
      slug: prog.slug,
      titleEn: prog.titleEn,
      titleBn: prog.titleBn,
      categoryEn: prog.categoryEn || '',
      categoryBn: prog.categoryBn || '',
      descriptionEn: prog.descriptionEn || '',
      descriptionBn: prog.descriptionBn || '',
      highlightEn: prog.highlightEn || '',
      highlightBn: prog.highlightBn || '',
      image: null,
      imageUrl: prog.imageUrl,
    })
    setEditingId(prog.id)
    setShowAddForm(true)
    setFormErrors({})
    setError(null)
  }

  const handleInputChange = (field, value) => {
    setFormData(prev => ({ ...prev, [field]: value }))
    // Clear error when user starts typing
    if (formErrors[field]) {
      setFormErrors(prev => ({
        ...prev,
        [field]: ''
      }))
    }
  }

  async function handleSubmit(e) {
    e.preventDefault()
    
    const errors = validateForm()
    if (Object.keys(errors).length > 0) {
      setFormErrors(errors)
      showToast('Please fix validation errors', 'error')
      return
    }

    setSubmitting(true)
    try {
      setError(null)
      const formBody = new FormData()

      // Text fields
      formBody.append('slug', formData.slug)
      formBody.append('titleEn', formData.titleEn)
      formBody.append('titleBn', formData.titleBn)
      formBody.append('categoryEn', formData.categoryEn)
      formBody.append('categoryBn', formData.categoryBn)
      formBody.append('descriptionEn', formData.descriptionEn)
      formBody.append('descriptionBn', formData.descriptionBn)
      formBody.append('highlightEn', formData.highlightEn)
      formBody.append('highlightBn', formData.highlightBn)

      // Image
      if (formData.image) {
        formBody.append('image', formData.image)
      }

      let res
      if (editingId) {
        res = await request('PATCH', `/api/admin/programs/${editingId}`, formBody, { isFormData: true })
      } else {
        res = await request('POST', '/api/admin/programs', formBody, { isFormData: true })
      }

      if (res.success) {
        showToast(editingId ? 'Program updated successfully' : 'Program created successfully', 'success')
        resetForm()
        await fetchPrograms()
        setShowAddForm(false)
      }
    } catch (err) {
      const errorMsg = 'Error: ' + err.message
      setError(errorMsg)
      showToast(errorMsg, 'error')
    } finally {
      setSubmitting(false)
    }
  }

  const confirmDelete = (programId) => {
    setDeleteConfirm({ isOpen: true, programId })
  }

  async function deleteProgram() {
    const { programId } = deleteConfirm
    if (!programId) return

    try {
      setLoading(true)
      const res = await request('DELETE', `/api/admin/programs/${programId}`)
      if (res.success) {
        showToast('Program deleted successfully', 'success')
        setDeleteConfirm({ isOpen: false, programId: null })
        await fetchPrograms()
      }
    } catch (err) {
      const errorMsg = 'Delete failed: ' + err.message
      setError(errorMsg)
      showToast(errorMsg, 'error')
    } finally {
      setLoading(false)
    }
  }

  function moveProgram(programId, direction) {
    const currentIndex = programs.findIndex((item) => item.id === programId)
    const targetIndex = currentIndex + direction

    if (currentIndex < 0 || targetIndex < 0 || targetIndex >= programs.length) {
      return
    }

    const updated = [...programs]
    const [moved] = updated.splice(currentIndex, 1)
    updated.splice(targetIndex, 0, moved)

    setPrograms(updated)
    saveOrder(updated)
  }

  async function saveOrder(newList) {
    try {
      setReordering(true)
      const items = newList.map((prog, idx) => ({ id: prog.id, sortOrder: idx }))
      const res = await request('PATCH', '/api/admin/programs/reorder', { items })
      if (res.success) {
        showToast('Program order saved', 'success')
      }
    } catch (err) {
      const errorMsg = 'Order save failed: ' + err.message
      showToast(errorMsg, 'error')
    } finally {
      setReordering(false)
    }
  }

  if (initialLoading) {
    return <LoadingSpinner fullPage text="Loading programs..." />
  }

  return (
    <div className="space-y-6 p-6">
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-3xl font-bold">Featured Programs</h1>
          <p className="text-gray-600 mt-1">Manage and order your programs</p>
        </div>
        <button
          onClick={() => {
            resetForm()
            setShowAddForm(true)
          }}
          className="flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition"
        >
          <Plus size={20} />
          Add Program
        </button>
      </div>

      {/* Error Message */}
      {error && !showAddForm && (
        <ErrorMessage 
          error={error} 
          onClose={() => setError(null)}
        />
      )}

      {showAddForm && (
        <div className="p-6 border border-gray-200 rounded-lg bg-white shadow">
          <h2 className="text-xl font-semibold mb-4">
            {editingId ? 'Edit Program' : 'New Program'}
          </h2>

          {error && (
            <ErrorMessage 
              error={error} 
              onClose={() => setError(null)}
              className="mb-4"
            />
          )}

          <form onSubmit={handleSubmit} className="space-y-4">
            {/* Slug field */}
            <div>
              <label className="block text-sm font-medium mb-1">
                Slug <span className="text-red-500">*</span>
              </label>
              <input
                type="text"
                value={formData.slug}
                onChange={(e) => handleInputChange('slug', e.target.value)}
                placeholder="e.g., education-initiative"
                className={`w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 ${
                  formErrors.slug
                    ? 'border-red-500 focus:ring-red-500'
                    : 'border-gray-300 focus:ring-blue-500'
                }`}
              />
              {formErrors.slug && (
                <p className="text-red-500 text-sm mt-1 flex items-center gap-1">
                  <AlertCircle size={14} /> {formErrors.slug}
                </p>
              )}
            </div>

            {/* Bilingual title */}
            <BilingualField
              labelEn="Title (EN)"
              labelBn="Title (BN)"
              valueEn={formData.titleEn}
              valueBn={formData.titleBn}
              onChangeEn={(v) => handleInputChange('titleEn', v)}
              onChangeBn={(v) => handleInputChange('titleBn', v)}
              required={true}
              errorEn={formErrors.titleEn}
              errorBn={formErrors.titleBn}
            />

            {/* Bilingual category */}
            <BilingualField
              labelEn="Category (EN)"
              labelBn="Category (BN)"
              valueEn={formData.categoryEn}
              valueBn={formData.categoryBn}
              onChangeEn={(v) => handleInputChange('categoryEn', v)}
              onChangeBn={(v) => handleInputChange('categoryBn', v)}
              errorEn={formErrors.categoryEn}
              errorBn={formErrors.categoryBn}
            />

            {/* Bilingual description */}
            <div>
              <label className="block text-sm font-medium mb-1">Description</label>
              <div className="grid grid-cols-2 gap-3">
                <div>
                  <textarea
                    value={formData.descriptionEn}
                    onChange={(e) => handleInputChange('descriptionEn', e.target.value)}
                    placeholder="Description (EN)"
                    className={`w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 text-sm ${
                      formErrors.descriptionEn
                        ? 'border-red-500 focus:ring-red-500'
                        : 'border-gray-300 focus:ring-blue-500'
                    }`}
                    rows={3}
                  />
                  {formErrors.descriptionEn && (
                    <p className="text-red-500 text-sm mt-1 flex items-center gap-1">
                      <AlertCircle size={14} /> {formErrors.descriptionEn}
                    </p>
                  )}
                </div>
                <div>
                  <textarea
                    value={formData.descriptionBn}
                    onChange={(e) => handleInputChange('descriptionBn', e.target.value)}
                    placeholder="বর্ণনা (BN)"
                    className={`w-full px-3 py-2 border rounded-lg focus:outline-none focus:ring-2 text-sm ${
                      formErrors.descriptionBn
                        ? 'border-red-500 focus:ring-red-500'
                        : 'border-gray-300 focus:ring-blue-500'
                    }`}
                    rows={3}
                  />
                  {formErrors.descriptionBn && (
                    <p className="text-red-500 text-sm mt-1 flex items-center gap-1">
                      <AlertCircle size={14} /> {formErrors.descriptionBn}
                    </p>
                  )}
                </div>
              </div>
            </div>

            {/* Bilingual highlight */}
            <BilingualField
              labelEn="Highlight (EN)"
              labelBn="Highlight (BN)"
              valueEn={formData.highlightEn}
              valueBn={formData.highlightBn}
              onChangeEn={(v) => handleInputChange('highlightEn', v)}
              onChangeBn={(v) => handleInputChange('highlightBn', v)}
              isTextArea={true}
            />

            {/* Image upload */}
            <div>
              <label className="block text-sm font-medium mb-2">Program Image</label>
              {formData.imageUrl && (
                <div className="mb-3 flex items-center gap-2">
                  <img src={formData.imageUrl} alt="preview" className="w-32 h-24 object-cover rounded" />
                  <button
                    type="button"
                    onClick={() => handleInputChange('imageUrl', '')}
                    className="text-sm text-red-600 hover:text-red-700"
                  >
                    Remove
                  </button>
                </div>
              )}
              <ImageUploader
                onFilesSelected={(files) => handleInputChange('image', files[0] || null)}
              />
              {formErrors.image && (
                <p className="text-red-500 text-sm mt-2 flex items-center gap-1">
                  <AlertCircle size={14} /> {formErrors.image}
                </p>
              )}
            </div>

            {/* Form actions */}
            <div className="flex gap-3 pt-2">
              <button
                type="submit"
                disabled={submitting || loading}
                className="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 disabled:opacity-50 transition flex items-center gap-2"
              >
                {submitting && <div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin" />}
                {submitting ? 'Saving...' : editingId ? 'Update' : 'Create'}
              </button>
              <button
                type="button"
                onClick={() => setShowAddForm(false)}
                disabled={submitting}
                className="px-6 py-2 bg-gray-300 text-gray-800 rounded-lg hover:bg-gray-400 disabled:opacity-50 transition"
              >
                Cancel
              </button>
            </div>
          </form>
        </div>
      )}

      {/* Programs list */}
      {programs.length === 0 ? (
        <div className="bg-gray-50 border border-gray-200 rounded-lg p-10 text-center">
          <p className="text-gray-600">No programs yet. Create your first one!</p>
        </div>
      ) : (
        <>
          <p className="text-sm text-gray-600">Total: {programs.length} programs</p>
          <div className="space-y-3">
            {programs.map((prog, index) => (
              <div key={prog.id} className="flex items-center gap-4 p-4 border border-gray-200 rounded-lg bg-white hover:shadow-md transition">
                <GripVertical size={18} className="text-gray-400" />
                {prog.imageUrl && (
                  <img src={prog.imageUrl} alt={prog.titleEn} className="w-24 h-20 object-cover rounded" />
                )}
                <div className="flex-1 min-w-0">
                  <p className="font-semibold text-gray-800 truncate">{prog.titleEn}</p>
                  <p className="text-sm text-gray-600 truncate">{prog.titleBn}</p>
                  {prog.categoryEn && <p className="text-xs text-blue-600">{prog.categoryEn}</p>}
                </div>
                <div className="flex items-center gap-2">
                  <button
                    type="button"
                    onClick={() => moveProgram(prog.id, -1)}
                    disabled={loading || reordering || index === 0}
                    className="px-3 py-1 bg-gray-100 text-gray-700 rounded hover:bg-gray-200 text-sm disabled:opacity-50 transition inline-flex items-center gap-1"
                    title="Move up"
                  >
                    <ArrowUp size={16} />
                  </button>
                  <button
                    type="button"
                    onClick={() => moveProgram(prog.id, 1)}
                    disabled={loading || reordering || index === programs.length - 1}
                    className="px-3 py-1 bg-gray-100 text-gray-700 rounded hover:bg-gray-200 text-sm disabled:opacity-50 transition inline-flex items-center gap-1"
                    title="Move down"
                  >
                    <ArrowDown size={16} />
                  </button>
                  <button
                    type="button"
                    onClick={() => editProgram(prog)}
                    disabled={loading || reordering}
                    className="px-3 py-1 bg-blue-100 text-blue-700 rounded hover:bg-blue-200 text-sm disabled:opacity-50 transition"
                  >
                    Edit
                  </button>
                  <button
                    type="button"
                    onClick={() => confirmDelete(prog.id)}
                    disabled={loading || reordering}
                    className="px-3 py-1 bg-red-100 text-red-700 rounded hover:bg-red-200 disabled:opacity-50 transition"
                    title="Delete"
                  >
                    <Trash2 size={16} />
                  </button>
                </div>
              </div>
            ))}
          </div>
        </>
      )}

      {/* Confirmation Dialog */}
      <ConfirmDialog
        isOpen={deleteConfirm.isOpen}
        title="Delete Program?"
        message="This program will be permanently deleted. This action cannot be undone."
        confirmText="Delete"
        cancelText="Cancel"
        isDangerous
        isLoading={loading}
        onConfirm={deleteProgram}
        onCancel={() => setDeleteConfirm({ isOpen: false, programId: null })}
      />

      {/* Toast notification */}
      {toast && (
        <Toast message={toast.message} type={toast.type} onDismiss={() => setToast(null)} />
      )}
    </div>
  )
}
</file>

<file path="packages/admin/src/pages/Settings.jsx">
import { useEffect, useState } from 'react'
import BilingualField from '../components/BilingualField'
import MediaUploadField from '../components/MediaUploadField'
import { Toast } from '../components/Toast'
import apiClient from '../lib/api'

const fieldConfig = [
  { fieldKey: 'org_name', label: 'NGO Name', type: 'text', helper: 'Shown in the public header and footer.' },
  { fieldKey: 'navbar_subtitle', label: 'Navbar Subtitle', type: 'bilingual', helper: 'Short line under the brand name in the public header.' },
  { fieldKey: 'footer_mission', label: 'Footer Mission Line', type: 'bilingual', helper: 'Short mission statement used in the public footer.' },
  { fieldKey: 'donate_button_label', label: 'Donate Button Label', type: 'bilingual', helper: 'Text for the header donate button.' },
  { fieldKey: 'facebook_label', label: 'Facebook Link Text', type: 'bilingual', helper: 'Text for the footer Facebook follow link.' },
  { fieldKey: 'phone', label: 'Phone Number', type: 'text', helper: 'Displayed on the contact page and footer.' },
  { fieldKey: 'email', label: 'Email Address', type: 'text', helper: 'Displayed on the contact page and footer.' },
  { fieldKey: 'address', label: 'Address', type: 'bilingual', helper: 'Displayed on the contact page and footer.' },
  { fieldKey: 'facebook_url', label: 'Facebook Page URL', type: 'text', helper: 'Button target for the official Facebook page.' },
  { fieldKey: 'contact_phone_label', label: 'Contact Card Phone Label', type: 'bilingual', helper: 'The word "Phone" shown above the phone number on contact page.' },
  { fieldKey: 'contact_email_label', label: 'Contact Card Email Label', type: 'bilingual', helper: 'The word "Email" shown above the email address on contact page.' },
  { fieldKey: 'contact_address_label', label: 'Contact Card Address Label', type: 'bilingual', helper: 'The word "Address" shown above the address on contact page.' },
]

function Settings() {
  const [form, setForm] = useState({})
  const [trustBadges, setTrustBadges] = useState([])
  const [navItems, setNavItems] = useState({})
  const [ariaLabels, setAriaLabels] = useState({})
  const [loading, setLoading] = useState(true)
  const [saving, setSaving] = useState(false)
  const [logoUploading, setLogoUploading] = useState(false)
  const [toast, setToast] = useState(null)

  useEffect(() => {
    async function fetchSettings() {
      try {
        setLoading(true)
        const response = await apiClient.get('/api/admin/content/settings')
        const sections = response.data?.sections || {}

        // Flatten general + contact sections into form
        const nextForm = {}
        for (const [sectionKey, section] of Object.entries(sections)) {
          if (sectionKey === 'trustBadges' || sectionKey === 'navItems') continue
          for (const [fieldKey, value] of Object.entries(section)) {
            nextForm[fieldKey] = { en: value.en ?? '', bn: value.bn ?? '' }
          }
        }
        setForm(nextForm)

        // Load trust badges from trustBadges section
        if (sections.trustBadges) {
          const items = Object.entries(sections.trustBadges)
            .sort(([a], [b]) => a.localeCompare(b))
            .map(([, value]) => ({ en: value.en || '', bn: value.bn || '' }))
            .filter((badge) => badge.en || badge.bn)
          setTrustBadges(items)
        }

        // Load aria labels from the general section
        const ariaForm = {}
        for (const key of ['hamburger_aria_label', 'nav_aria_label']) {
          if (sections.general?.[key]) {
            ariaForm[key] = { en: sections.general[key].en ?? '', bn: sections.general[key].bn ?? '' }
          }
        }
        setAriaLabels(ariaForm)

        // Load nav items
        if (sections.navItems) {
          const navForm = {}
          for (const [fieldKey, value] of Object.entries(sections.navItems)) {
            navForm[fieldKey] = { en: value.en ?? '', bn: value.bn ?? '' }
          }
          setNavItems(navForm)
        }
      } catch (error) {
        showToast(error.response?.data?.error || error.message || 'Failed to load settings', 'error')
      } finally {
        setLoading(false)
      }
    }

    fetchSettings()
  }, [])

  function showToast(message, type = 'success') {
    setToast({ message, type })
  }

  function updateField(fieldKey, language, value) {
    setForm((current) => ({
      ...current,
      [fieldKey]: {
        ...(current[fieldKey] || { en: '', bn: '' }),
        [language]: value,
      },
    }))
  }

  function updateNavItem(fieldKey, language, value) {
    setNavItems((current) => ({
      ...current,
      [fieldKey]: {
        ...(current[fieldKey] || { en: '', bn: '' }),
        [language]: value,
      },
    }))
  }

  async function uploadLogo(file) {
    setLogoUploading(true)
    try {
      const formData = new FormData()
      formData.append('file', file)
      formData.append('page', 'settings')
      formData.append('section', 'general')
      formData.append('fieldKey', 'logo_url')

      const response = await apiClient.post('/api/admin/media/upload', formData, {
        headers: { 'Content-Type': 'multipart/form-data' },
      })
      if (response.data?.data?.url) {
        setForm((current) => ({
          ...current,
          logo_url: { en: response.data.data.url, bn: '' },
        }))
      }
      showToast('Logo updated', 'success')
    } catch (error) {
      const msg = error.response?.data?.error || 'Failed to upload logo'
      showToast(msg, 'error')
    } finally {
      setLogoUploading(false)
    }
  }

  async function deleteLogo() {
    setLogoUploading(true)
    try {
      await apiClient.delete('/api/admin/media/settings/general/logo_url')
      setForm((current) => ({
        ...current,
        logo_url: { en: '', bn: '' },
      }))
      showToast('Logo removed', 'success')
    } catch (error) {
      const msg = error.response?.data?.error || 'Failed to remove logo'
      showToast(msg, 'error')
    } finally {
      setLogoUploading(false)
    }
  }

  async function handleSave(e) {
    e.preventDefault()
    setSaving(true)

    try {
      await Promise.all(
        fieldConfig.map((field) =>
          apiClient.patch(`/api/admin/content/settings/${field.fieldKey}`, {
            valueEn: form[field.fieldKey]?.en ?? '',
            valueBn: field.type === 'bilingual' ? form[field.fieldKey]?.bn ?? '' : null,
          }),
        ),
      )

      // Save trust badges: fetch existing keys, save current, delete orphans
      const existingResp = await apiClient.get('/api/admin/content/settings')
      const existingKeys = existingResp.data?.sections?.trustBadges
        ? Object.keys(existingResp.data.sections.trustBadges).sort()
        : []

      await Promise.all(
        trustBadges.map((badge, i) =>
          apiClient.patch(`/api/admin/content/settings/trustBadges/item_${i}`, {
            valueEn: badge.en,
            valueBn: badge.bn,
          }),
        ),
      )

      // Delete orphaned badge rows
      const deletePromises = existingKeys
        .filter((key) => {
          const idx = parseInt(key.replace('item_', ''), 10)
          return idx >= trustBadges.length
        })
        .map((key) => apiClient.delete(`/api/admin/content/settings/trustBadges/${key}`))
      await Promise.all(deletePromises)

      // Save nav items
      await Promise.all(
        Object.entries(navItems).map(([fieldKey, value]) =>
          apiClient.patch(`/api/admin/content/settings/navItems/${fieldKey}`, {
            valueEn: value.en ?? '',
            valueBn: value.bn ?? '',
          }),
        ),
      )

      // Save aria labels
      if (ariaLabels.hamburger_aria_label?.en || ariaLabels.hamburger_aria_label?.bn) {
        await apiClient.patch('/api/admin/content/settings/hamburger_aria_label', {
          valueEn: ariaLabels.hamburger_aria_label.en,
          valueBn: ariaLabels.hamburger_aria_label.bn,
        })
      }
      if (ariaLabels.nav_aria_label?.en || ariaLabels.nav_aria_label?.bn) {
        await apiClient.patch('/api/admin/content/settings/nav_aria_label', {
          valueEn: ariaLabels.nav_aria_label.en,
          valueBn: ariaLabels.nav_aria_label.bn,
        })
      }

      showToast('Settings saved successfully', 'success')
    } catch (error) {
      showToast(error.response?.data?.error || error.message || 'Failed to save settings', 'error')
    } finally {
      setSaving(false)
    }
  }

  if (loading) {
    return (
      <section>
        <h1 className="text-2xl font-bold mb-6">Site Settings</h1>
        <p className="text-gray-500">Loading settings...</p>
      </section>
    )
  }

  return (
    <section className="max-w-4xl">
      <div className="mb-8">
        <h1 className="text-2xl font-bold mb-2">Site Settings</h1>
        <p className="text-gray-600">Manage the shared site identity, trust badges, contact details, and footer copy used across the public site.</p>
      </div>

      <form onSubmit={handleSave} className="space-y-6">
        <div className="bg-white border border-gray-200 rounded-lg p-6 shadow-sm space-y-6">
          <div>
            <p className="text-sm font-semibold text-gray-900 mb-1">Brand Identity</p>
            <p className="text-sm text-gray-500">These values drive the header subtitle and footer line.</p>
          </div>

          <MediaUploadField
            label="NGO Logo"
            helperText="Upload the organization logo. Shown in the public header and footer."
            currentUrl={form.logo_url?.en || ''}
            currentAlt="NGO logo"
            onUpload={uploadLogo}
            onDelete={form.logo_url?.en ? deleteLogo : undefined}
            uploading={logoUploading}
            previewClassName="h-24 w-auto object-contain"
          />

          {fieldConfig.slice(0, 5).map((field) => (
            <div key={field.fieldKey}>
              {field.type === 'bilingual' ? (
                <BilingualField
                  labelEn={field.label}
                  labelBn={field.label}
                  valueEn={form[field.fieldKey]?.en || ''}
                  valueBn={form[field.fieldKey]?.bn || ''}
                  onChangeEn={(value) => updateField(field.fieldKey, 'en', value)}
                  onChangeBn={(value) => updateField(field.fieldKey, 'bn', value)}
                  type="text"
                  isTextArea={false}
                  required={field.fieldKey === 'navbar_subtitle'}
                  />
              ) : (
                <div>
                  <label htmlFor={field.fieldKey} className="block text-sm font-semibold text-gray-900 mb-2">
                    {field.label}
                  </label>
                  <input
                    id={field.fieldKey}
                    type="text"
                    value={form[field.fieldKey]?.en || ''}
                    onChange={(event) => updateField(field.fieldKey, 'en', event.target.value)}
                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                  />
                </div>
              )}
              <p className="text-xs text-gray-500 mt-1">{field.helper}</p>
            </div>
          ))}
        </div>

        <div className="bg-white border border-gray-200 rounded-lg p-6 shadow-sm space-y-6">
          <div>
            <p className="text-sm font-semibold text-gray-900 mb-1">Contact Details</p>
            <p className="text-sm text-gray-500">These values power the Contact page and footer contact block.</p>
          </div>

          {fieldConfig.slice(5).map((field) => (
            <div key={field.fieldKey}>
              {field.type === 'bilingual' ? (
                <BilingualField
                  labelEn={field.label}
                  labelBn={field.label}
                  valueEn={form[field.fieldKey]?.en || ''}
                  valueBn={form[field.fieldKey]?.bn || ''}
                  onChangeEn={(value) => updateField(field.fieldKey, 'en', value)}
                  onChangeBn={(value) => updateField(field.fieldKey, 'bn', value)}
                  isTextArea={true}
                  required={field.fieldKey === 'address'}
                />
              ) : (
                <div>
                  <label htmlFor={field.fieldKey} className="block text-sm font-semibold text-gray-900 mb-2">
                    {field.label}
                  </label>
                  <input
                    id={field.fieldKey}
                    type={field.fieldKey === 'email' ? 'email' : field.fieldKey === 'facebook_url' ? 'url' : 'tel'}
                    value={form[field.fieldKey]?.en || ''}
                    onChange={(event) => updateField(field.fieldKey, 'en', event.target.value)}
                    className="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                    placeholder={field.fieldKey === 'facebook_url' ? 'https://facebook.com/yourpage' : ''}
                  />
                </div>
              )}
              <p className="text-xs text-gray-500 mt-1">{field.helper}</p>
            </div>
          ))}
        </div>

        <div className="bg-white border border-gray-200 rounded-lg p-6 shadow-sm space-y-6">
          <div>
            <p className="text-sm font-semibold text-gray-900 mb-1">Trust Badges</p>
            <p className="text-sm text-gray-500">Bilingual badges shown in the trust strip on the home page. Add or remove as needed. Each badge is fully customizable — type exactly what you want to display.</p>
          </div>

          <div className="space-y-3">
            {trustBadges.map((badge, i) => (
              <div key={i} className="flex gap-2 items-start">
                <input
                  type="text"
                  value={badge.en}
                  onChange={(e) => {
                    const next = [...trustBadges]
                    next[i] = { ...next[i], en: e.target.value }
                    setTrustBadges(next)
                  }}
                  placeholder="English (e.g., Est. 2005)"
                  className="flex-1 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <input
                  type="text"
                  value={badge.bn}
                  onChange={(e) => {
                    const next = [...trustBadges]
                    next[i] = { ...next[i], bn: e.target.value }
                    setTrustBadges(next)
                  }}
                  placeholder="Bangla (e.g., প্রতিষ্ঠিত ২০০৫)"
                  className="flex-1 px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
                />
                <button
                  type="button"
                  onClick={() => setTrustBadges(trustBadges.filter((_, j) => j !== i))}
                  className="px-3 py-2 text-red-600 hover:bg-red-50 rounded-md text-sm font-medium"
                >
                  Remove
                </button>
              </div>
            ))}
          </div>

          <button
            type="button"
            onClick={() => setTrustBadges([...trustBadges, { en: '', bn: '' }])}
            className="px-4 py-2 border border-dashed border-gray-400 text-gray-600 rounded-md hover:bg-gray-50 text-sm font-medium"
          >
            + Add Badge
          </button>
        </div>

        <div className="bg-white border border-gray-200 rounded-lg p-6 shadow-sm space-y-6">
          <div>
            <p className="text-sm font-semibold text-gray-900 mb-1">Navigation Labels</p>
            <p className="text-sm text-gray-500">Bilingual text for each link in the public site header navigation.</p>
          </div>
          {[
            { fieldKey: 'home', label: 'Home' },
            { fieldKey: 'about', label: 'About' },
            { fieldKey: 'ourWork', label: 'Our Work' },
            { fieldKey: 'impact', label: 'Impact' },
            { fieldKey: 'gallery', label: 'Gallery' },
            { fieldKey: 'getInvolved', label: 'Get Involved' },
            { fieldKey: 'contact', label: 'Contact' },
          ].map((item) => (
            <BilingualField
              key={item.fieldKey}
              labelEn={item.label}
              labelBn={item.label + ' (Bangla)'}
              valueEn={navItems[item.fieldKey]?.en || ''}
              valueBn={navItems[item.fieldKey]?.bn || ''}
              onChangeEn={(value) => updateNavItem(item.fieldKey, 'en', value)}
              onChangeBn={(value) => updateNavItem(item.fieldKey, 'bn', value)}
              type="text"
            />
          ))}
        </div>

        <div className="bg-white border border-gray-200 rounded-lg p-6 shadow-sm space-y-6">
          <div>
            <p className="text-sm font-semibold text-gray-900 mb-1">Accessibility Labels</p>
            <p className="text-sm text-gray-500">Aria labels for the public site navigation elements.</p>
          </div>
          <BilingualField
            labelEn="Hamburger Menu Aria Label"
            labelBn="মোবাইল মেনু লেবেল"
            valueEn={ariaLabels.hamburger_aria_label?.en || ''}
            valueBn={ariaLabels.hamburger_aria_label?.bn || ''}
            onChangeEn={(value) => setAriaLabels((p) => ({ ...p, hamburger_aria_label: { ...p.hamburger_aria_label, en: value } }))}
            onChangeBn={(value) => setAriaLabels((p) => ({ ...p, hamburger_aria_label: { ...p.hamburger_aria_label, bn: value } }))}
            type="text"
          />
          <BilingualField
            labelEn="Navigation Aria Label"
            labelBn="নেভিগেশন লেবেল"
            valueEn={ariaLabels.nav_aria_label?.en || ''}
            valueBn={ariaLabels.nav_aria_label?.bn || ''}
            onChangeEn={(value) => setAriaLabels((p) => ({ ...p, nav_aria_label: { ...p.nav_aria_label, en: value } }))}
            onChangeBn={(value) => setAriaLabels((p) => ({ ...p, nav_aria_label: { ...p.nav_aria_label, bn: value } }))}
            type="text"
          />
        </div>

        <div className="flex flex-wrap gap-3 justify-between items-center pt-2">
          <p className="text-sm text-gray-500">Changes are saved field-by-field to keep the editor resilient.</p>
          <button
            type="submit"
            disabled={saving}
            className="px-6 py-2 bg-blue-600 text-white rounded-md font-medium hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            {saving ? 'Saving...' : 'Save Settings'}
          </button>
        </div>
      </form>

      {toast && (
        <Toast
          message={toast.message}
          type={toast.type}
          onDismiss={() => setToast(null)}
        />
      )}
    </section>
  )
}

export default Settings
</file>

<file path="packages/api/src/data/staticContent.js">
/**
 * Static content fallbacks for the API.
 * These serve as defaults when database records are missing.
 * This file contains no external package dependencies and is safe for deployment.
 */

export const navItems = [
  { to: '/', fieldKey: 'home', label: { en: 'Home', bn: 'হোম' } },
  { to: '/about', fieldKey: 'about', label: { en: 'About', bn: 'আমাদের কথা' } },
  { to: '/our-work', fieldKey: 'ourWork', label: { en: 'Our Work', bn: 'আমাদের কাজ' } },
  { to: '/impact', fieldKey: 'impact', label: { en: 'Impact', bn: 'ফলাফল' } },
