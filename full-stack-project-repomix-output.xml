  object-fit: cover;
  display: block;
}
.doc-card .card-body { flex: 1 }
.doc-card .small { margin-top: 6px; font-size: 0.85rem }

/* Modal styles */
.doc-modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.64);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 24px;
  animation: docOverlayFade 180ms ease-out;
}
.doc-modal {
  background: white;
  border-radius: 12px;
  max-width: 1100px;
  width: 100%;
  max-height: 90vh;
  overflow: hidden;
  box-shadow: 0 20px 60px rgba(2,6,23,0.6);
  position: relative;
  transform-origin: center;
  animation: docModalZoom 220ms cubic-bezier(0.22, 1, 0.36, 1);
}
.doc-modal-close {
  position: absolute;
  right: 12px;
  top: 8px;
  background: transparent;
  border: 0;
  font-size: 28px;
  line-height: 1;
  cursor: pointer;
}
.doc-modal-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  border: none;
  border-radius: 50%;
  width: 52px;
  height: 52px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  color: white;
  transition: all 200ms cubic-bezier(0.22, 1, 0.36, 1);
  z-index: 10000;
  box-shadow: 0 4px 16px rgba(59, 130, 246, 0.3);
}
.doc-modal-nav:hover {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
  box-shadow: 0 8px 24px rgba(59, 130, 246, 0.4);
  transform: translateY(-50%) scale(1.1);
}
.doc-modal-nav:active {
  transform: translateY(-50%) scale(0.95);
}
.doc-modal-nav:focus {
  outline: 2px solid white;
  outline-offset: 3px;
  box-shadow: 0 4px 16px rgba(59, 130, 246, 0.3), 0 0 0 4px rgba(59, 130, 246, 0.2);
}
.doc-modal-nav svg {
  width: 24px;
  height: 24px;
  display: block;
}
.doc-modal-prev {
  left: 16px;
}
.doc-modal-next {
  right: 16px;
}
.doc-modal-body { padding: 18px; display: flex; flex-direction: column; gap: 12px }
.doc-modal-title { margin: 0; font-size: 1.1rem }
.doc-modal-inner { background: #f7fafc; border-radius: 8px; overflow: hidden; min-height: 320px; display: flex; align-items: center; justify-content: center }
.doc-modal-inner img { width: auto; max-width: 100%; height: auto; max-height: 72vh }
.doc-modal-inner iframe { width: 100%; height: 72vh; border: 0 }
.doc-modal-actions { display: flex; gap: 8px; justify-content: flex-end }

@keyframes docOverlayFade {
  from { opacity: 0 }
  to { opacity: 1 }
}

@keyframes docModalZoom {
  from {
    opacity: 0;
    transform: scale(0.975) translateY(8px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .doc-modal-overlay,
  .doc-modal {
    animation: none;
  }
  .doc-modal-nav {
    transition: none;
  }
  .doc-modal-nav:hover {
    transform: translateY(-50%);
  }
  .doc-modal-nav:active {
    transform: translateY(-50%);
  }
}


