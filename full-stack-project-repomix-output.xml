import { Router } from 'express'
import { body } from 'express-validator'
import { prisma } from '../../lib/prisma.js'
import { invalidateCache } from '../../lib/contentCache.js'
import { verifyJWT } from '../../middleware/verifyJWT.js'
import { handleValidationErrors, validateFundAllocation } from '../../middleware/validation.js'

const router = Router()

router.use(verifyJWT)

router.get('/', async (_req, res) => {
  try {
    const items = await prisma.fundAllocation.findMany({
      orderBy: { sortOrder: 'asc' },
    })

    res.json({ success: true, items })
  } catch (error) {
    res.status(500).json({ error: 'Failed to fetch fund allocation' })
  }
})

router.post(
  '/',
  [...validateFundAllocation()],
  handleValidationErrors,
  async (req, res) => {
    try {
      const { categoryEn, categoryBn, percentage, sortOrder = 0 } = req.body

      const item = await prisma.fundAllocation.create({
        data: {
          categoryEn,
          categoryBn,
          percentage: Number(percentage),
          sortOrder: Number(sortOrder),
        },
      })

      invalidateCache()

      res.json({ success: true, data: item })
    } catch (error) {
      res.status(500).json({ error: 'Failed to create fund allocation' })
    }
  }
)

router.patch('/batch', async (req, res) => {
  try {
    const { items } = req.body

    if (!Array.isArray(items)) {
      return res.status(400).json({ error: 'items must be an array' })
    }
    if (!items.every((item) => Number.isInteger(Number(item.id)) && Number(item.id) > 0 && Number.isInteger(Number(item.sortOrder)))) {
      return res.status(400).json({ error: 'Each item must have a valid id and sortOrder' })
    }

    const updated = await Promise.all(
      items.map((item) =>
        prisma.fundAllocation.update({
          where: { id: Number(item.id) },
          data: {
            categoryEn: item.categoryEn,
            categoryBn: item.categoryBn,
            percentage: Number(item.percentage),
            sortOrder: Number(item.sortOrder),
          },
        })
      )
    )

    // Invalidate cache so changes appear immediately
    invalidateCache()

    res.json({ success: true, updated })
  } catch (error) {
    res.status(500).json({ error: 'Failed to update fund allocation batch' })
  }
})

router.patch('/:id', async (req, res) => {
  try {
    const { id } = req.params
    const { categoryEn, categoryBn, percentage, sortOrder } = req.body

    const item = await prisma.fundAllocation.update({
      where: { id: Number(id) },
      data: {
        ...(categoryEn !== undefined && { categoryEn }),
        ...(categoryBn !== undefined && { categoryBn }),
        ...(percentage !== undefined && { percentage: Number(percentage) }),
        ...(sortOrder !== undefined && { sortOrder: Number(sortOrder) }),
      },
    })

    // Invalidate cache so changes appear immediately
    invalidateCache()

    res.json({ success: true, data: item })
  } catch (error) {
    res.status(500).json({ error: 'Failed to update fund allocation' })
  }
})

router.delete('/:id', async (req, res) => {
  try {
    const { id } = req.params

    await prisma.fundAllocation.delete({
      where: { id: Number(id) },
    })

    // Invalidate cache so changes appear immediately
    invalidateCache()

    res.json({ success: true, message: 'Fund allocation deleted' })
  } catch (error) {
    res.status(500).json({ error: 'Failed to delete fund allocation' })
  }
})

export default router
</file>

<file path="packages/api/src/routes/admin/gallery.js">
import { Router } from 'express'
import { body, param, validationResult } from 'express-validator'
import { prisma } from '../../lib/prisma.js'
import { invalidateCache } from '../../lib/contentCache.js'
import { uploadToCloudinary, deleteFromCloudinary } from '../../lib/cloudinary.js'
import { upload } from '../../middleware/uploadMiddleware.js'
import { verifyJWT } from '../../middleware/verifyJWT.js'
import {
  handleValidationErrors,
  validateGalleryItem,
  validateId,
} from '../../middleware/validation.js'

const router = Router()

router.use(verifyJWT)

// GET /api/admin/gallery
router.get('/', async (_req, res) => {
  try {
    const items = await prisma.galleryItem.findMany({ orderBy: { sortOrder: 'asc' } })
    res.json({ success: true, items })
  } catch (err) {
    console.error('Failed fetching gallery items:', err)
    res.status(500).json({ error: 'Failed to fetch gallery items' })
  }
})

// POST /api/admin/gallery
// Supports the current admin UI contract: multipart/form-data with `files`
router.post('/', upload.array('files', 5), async (req, res) => {
  try {
    if (!req.files || req.files.length === 0) {
      return res.status(400).json({ error: 'No files provided' })
    }

    if (!process.env.CLOUDINARY_API_KEY || !process.env.CLOUDINARY_API_SECRET || !process.env.CLOUDINARY_CLOUD_NAME) {
      return res.status(500).json({ error: 'Cloudinary not configured' })
    }

    const highestSort = await prisma.galleryItem.aggregate({ _max: { sortOrder: true } })
    let nextSortOrder = (highestSort._max.sortOrder ?? -1) + 1

    const VALID_CATEGORIES = ['gallery', 'team', 'events', 'programs']
    const category = req.body.category || 'gallery'
    if (!VALID_CATEGORIES.includes(category)) {
      return res.status(400).json({ error: `Invalid category. Must be one of: ${VALID_CATEGORIES.join(', ')}` })
    }
    const altEn = req.body.altEn || ''
    const altBn = req.body.altBn || ''
    const uploaded = []

    for (const file of req.files) {
      const cloudinaryData = await uploadToCloudinary(file.buffer, 'heritage-of-hope/gallery', {
        resourceType: 'image',
        transformation: [{ width: 1200, crop: 'limit', quality: 'auto:good' }],
      })

      const item = await prisma.galleryItem.create({
        data: {
          url: cloudinaryData.secure_url,
          publicId: cloudinaryData.public_id,
          altEn: altEn || file.originalname,
          altBn: altBn || file.originalname,
          category,
          sortOrder: nextSortOrder,
        },
      })

      uploaded.push(item)
      nextSortOrder += 1
    }

    // Invalidate cache so changes appear immediately
    invalidateCache()

    res.json({ success: true, uploaded, count: uploaded.length })
  } catch (error) {
    console.error('Gallery upload error:', error)
    res.status(500).json({ error: `Upload failed: ${error.message}` })
  }
})

// PATCH /api/admin/gallery/reorder
router.patch('/reorder', async (req, res) => {
  try {
    const { items } = req.body

    if (!Array.isArray(items) || items.length === 0) {
      return res.status(400).json({ error: 'No reorder items provided' })
    }
    if (!items.every((item) => Number.isInteger(Number(item.id)) && Number(item.id) > 0 && Number.isInteger(Number(item.sortOrder)))) {
      return res.status(400).json({ error: 'Each item must have a valid id and sortOrder' })
    }

    const updated = await Promise.all(
      items.map((item) =>
        prisma.galleryItem.update({
          where: { id: Number(item.id) },
          data: { sortOrder: Number(item.sortOrder) },
        })
      )
    )

    // Invalidate cache so changes appear immediately
    invalidateCache()

    res.json({ success: true, updated })
  } catch (error) {
    console.error('Failed updating gallery order:', error)
    res.status(500).json({ error: 'Failed to update sort order' })
  }
})

// PATCH /api/admin/gallery/:id
router.patch(
  '/:id',
  [
    validateId('id'),
    ...validateGalleryItem(),
  ],
  handleValidationErrors,
  async (req, res) => {
    try {
      const { id } = req.params
      const { category, altEn, altBn } = req.body

      const item = await prisma.galleryItem.update({
        where: { id: Number(id) },
        data: {
          ...(category !== undefined && { category: category.trim() }),
          ...(altEn !== undefined && { altEn: altEn.trim() }),
          ...(altBn !== undefined && { altBn: altBn.trim() }),
        },
      })

      // Invalidate cache so changes appear immediately
      invalidateCache()

      res.json({ success: true, item })
    } catch (error) {
      console.error('Failed updating gallery item:', error)
      res.status(500).json({ error: 'Failed to update gallery item' })
    }
  }
)

// DELETE /api/admin/gallery/:id
router.delete(
  '/:id',
  [validateId('id')],
  handleValidationErrors,
  async (req, res) => {
    try {
      const { id } = req.params

      const item = await prisma.galleryItem.findUnique({ where: { id: Number(id) } })

      if (!item) {
        return res.status(404).json({ error: 'Gallery item not found' })
      }

      if (item.publicId) {
        try {
          await deleteFromCloudinary(item.publicId)
        } catch (deleteErr) {
          console.warn('Failed to delete Cloudinary asset:', deleteErr)
        }
      }

      await prisma.galleryItem.delete({ where: { id: Number(id) } })

      // Invalidate cache so changes appear immediately
      invalidateCache()

      res.json({ success: true, message: 'Gallery item deleted' })
    } catch (error) {
      console.error('Gallery delete error:', error)
      res.status(500).json({ error: 'Failed to delete gallery item' })
