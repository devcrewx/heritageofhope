          </div>
          <div>
            <label className="block text-sm font-medium text-gray-900 mb-1">Alt Text EN</label>
            <input
              type="text"
              value={uploadAltEn}
              onChange={(e) => {
                setUploadAltEn(e.target.value)
                if (formErrors.uploadAltEn) {
