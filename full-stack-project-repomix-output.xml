<file path="packages/api/prisma/schema.prisma">
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteContent {
  id        Int      @id @default(autoincrement())
  page      String
  section   String
  fieldKey  String   @map("field_key")
  valueEn   String?  @map("value_en") @db.Text
  valueBn   String?  @map("value_bn") @db.Text
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([page, section, fieldKey])
  @@index([section])
  @@map("site_content")
}

model ImpactStat {
  id        Int    @id @default(autoincrement())
  value     String @unique
  labelEn   String @map("label_en")
  labelBn   String? @map("label_bn")
  sortOrder Int    @default(0) @map("sort_order")

  @@index([sortOrder])
  @@map("impact_stats")
}

model GalleryItem {
  id        Int      @id @default(autoincrement())
  url       String   @unique @db.Text
  publicId  String   @map("public_id") @db.Text
  altEn     String?  @map("alt_en")
  altBn     String?  @map("alt_bn")
  category  String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([category])
  @@index([sortOrder])
  @@map("gallery_items")
}

model Document {
  id            Int      @id @default(autoincrement())
  titleEn       String   @map("title_en")
  titleBn       String?  @map("title_bn")
  descriptionEn String?  @map("description_en") @db.Text
  descriptionBn String?  @map("description_bn") @db.Text
  date          DateTime? @db.Date
  pdfUrl        String?  @map("pdf_url") @db.Text
  pdfPublicId   String?  @map("pdf_public_id") @db.Text
  previewImgUrl String?  @map("preview_img_url") @db.Text
  previewImgPublicId String? @map("preview_img_public_id") @db.Text
  sortOrder     Int      @default(0) @map("sort_order")

  @@index([sortOrder])
  @@map("documents")
}

model TeamMember {
  id            Int     @id @default(autoincrement())
  name          String
  roleEn        String? @map("role_en")
  roleBn        String? @map("role_bn")
  photoUrl      String? @unique @map("photo_url") @db.Text
  photoPublicId String? @map("photo_public_id") @db.Text
  sortOrder     Int     @default(0) @map("sort_order")

  @@index([sortOrder])
  @@map("team_members")
}

model CoreValue {
  id            Int     @id @default(autoincrement())
  titleEn       String  @unique @map("title_en")
  titleBn       String? @map("title_bn")
  descriptionEn String? @map("description_en") @db.Text
  descriptionBn String? @map("description_bn") @db.Text
  sortOrder     Int     @default(0) @map("sort_order")

  @@index([sortOrder])
  @@map("core_values")
}

model Partner {
  id           Int     @id @default(autoincrement())
  name         String  @unique
  logoUrl      String? @map("logo_url") @db.Text
  logoPublicId String? @map("logo_public_id") @db.Text
  isActive     Boolean @default(true) @map("is_active")
  sortOrder    Int     @default(0) @map("sort_order")

  @@index([isActive])
  @@index([sortOrder])
  @@map("partners")
}

model DonationTier {
  id        Int     @id @default(autoincrement())
  amount    Int     @unique
  labelEn   String  @map("label_en")
  labelBn   String? @map("label_bn")
  sortOrder Int     @default(0) @map("sort_order")

  @@index([sortOrder])
  @@map("donation_tiers")
}

model FundAllocation {
  id         Int     @id @default(autoincrement())
  categoryEn String  @unique @map("category_en")
  categoryBn String? @map("category_bn")
  percentage Int
  sortOrder  Int     @default(0) @map("sort_order")

  @@index([sortOrder])
  @@map("fund_allocation")
}

model VolunteerRole {
  id            Int     @id @default(autoincrement())
  titleEn       String  @unique @map("title_en")
  titleBn       String? @map("title_bn")
  descriptionEn String? @map("description_en") @db.Text
  descriptionBn String? @map("description_bn") @db.Text
  sortOrder     Int     @default(0) @map("sort_order")

  @@index([sortOrder])
  @@map("volunteer_roles")
}

model ActivityPost {
  id          Int      @id @default(autoincrement())
  date        DateTime @db.Date
  titleEn     String   @unique @map("title_en")
  titleBn     String?  @map("title_bn")
  bodyEn      String?  @map("body_en") @db.Text
  bodyBn      String?  @map("body_bn") @db.Text
  photoUrl    String?  @map("photo_url") @db.Text
  photoPublicId String? @map("photo_public_id") @db.Text
  isPublished Boolean  @default(true) @map("is_published")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([isPublished])
  @@index([sortOrder])
  @@index([isPublished, sortOrder])
  @@map("activity_posts")
}

model AdminUser {
  id                Int        @id @default(autoincrement())
  email             String     @unique
  passwordHash      String     @map("password_hash") @db.Text
  role              String     @default("editor")
  createdAt         DateTime   @default(now()) @map("created_at")
  lastLogin         DateTime?  @map("last_login")
  resetToken        String?    @unique @map("reset_token")
  resetTokenExpires DateTime?  @map("reset_token_expires")
  auditLogs         AuditLog[]

  @@index([email])
  @@map("admin_users")
}

model Program {
  id            Int     @id @default(autoincrement())
  slug          String  @unique
  imageUrl      String  @map("image_url") @db.Text
  imagePublicId String? @map("image_public_id")
  categoryEn    String  @map("category_en")
  categoryBn    String? @map("category_bn")
  titleEn       String  @map("title_en")
  titleBn       String? @map("title_bn")
  descriptionEn String? @map("description_en") @db.Text
  descriptionBn String? @map("description_bn") @db.Text
  highlightEn   String? @map("highlight_en")
  highlightBn   String? @map("highlight_bn")
  sortOrder     Int     @default(0) @map("sort_order")

  @@index([sortOrder])
  @@map("programs")
}

model AuditLog {
  id        Int       @id @default(autoincrement())
  adminId   Int?      @map("admin_id")
  action    String?
  tableName String?   @map("table_name")
  recordId  Int?      @map("record_id")
  note      String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")
  admin     AdminUser? @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([tableName])
  @@map("audit_log")
}

model ContactSubmission {
  id        Int       @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  message   String    @db.Text
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("contact_submissions")
}

model VolunteerSubmission {
  id        Int       @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  interest  String?   // e.g. "Teaching", "Healthcare", "Admin"
  message   String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("volunteer_submissions")
}

model PartnerSubmission {
  id               Int       @id @default(autoincrement())
  organizationName String    @map("organization_name")
  contactPerson    String    @map("contact_person")
  email            String
  phone            String?
  inquiry          String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("partner_submissions")
}
</file>

<file path="packages/api/src/routes/admin/documents.js">
import { Router } from 'express'
import multer from 'multer'
import { prisma } from '../../lib/prisma.js'
import { invalidateCache } from '../../lib/contentCache.js'
import { uploadToCloudinary, deleteFromCloudinary } from '../../lib/cloudinary.js'
import { verifyJWT } from '../../middleware/verifyJWT.js'

const router = Router()
const storage = multer.memoryStorage()

const fileFilter = (_req, file, cb) => {
  const allowedImageMimes = ['image/jpeg', 'image/png', 'image/webp']
  const allowedPdfMimes = ['application/pdf']

  if (allowedPdfMimes.includes(file.mimetype) || allowedImageMimes.includes(file.mimetype)) {
    cb(null, true)
    return
  }

  cb(new Error('Only PDF and image files are allowed'))
}

const upload = multer({
  storage,
  fileFilter,
  limits: { fileSize: 15 * 1024 * 1024 },
})

router.use(verifyJWT)

router.get('/', async (_req, res) => {
  try {
    const items = await prisma.document.findMany({ orderBy: { sortOrder: 'asc' } })
    res.json({ success: true, items })
  } catch (err) {
    console.error('Failed fetching documents:', err)
    res.status(500).json({ error: 'Failed to fetch documents' })
  }
})

router.post('/', upload.fields([{ name: 'pdf', maxCount: 1 }, { name: 'preview', maxCount: 1 }]), async (req, res) => {
  try {
    const { titleEn, titleBn, descriptionEn, descriptionBn, date } = req.body
    const pdfFile = req.files?.pdf?.[0]
    const previewFile = req.files?.preview?.[0]

    if (!titleEn) return res.status(400).json({ error: 'titleEn is required' })
    if (!pdfFile) return res.status(400).json({ error: 'PDF file is required' })

    if (!process.env.CLOUDINARY_API_KEY || !process.env.CLOUDINARY_API_SECRET || !process.env.CLOUDINARY_CLOUD_NAME) {
      return res.status(500).json({ error: 'Cloudinary not configured' })
    }

    const highestSort = await prisma.document.aggregate({ _max: { sortOrder: true } })
    const nextSortOrder = (highestSort._max.sortOrder ?? -1) + 1

    const pdfData = await uploadToCloudinary(pdfFile.buffer, 'heritage-of-hope/documents', {
      resourceType: 'raw',
    })

    let previewImgUrl = null
    let previewImgPublicId = null
    if (previewFile) {
      const previewData = await uploadToCloudinary(previewFile.buffer, 'heritage-of-hope/documents/previews', {
        resourceType: 'image',
        transformation: [{ width: 800, crop: 'limit', quality: 'auto:good' }],
      })
      previewImgUrl = previewData.secure_url
      previewImgPublicId = previewData.public_id
    }

    const item = await prisma.document.create({
      data: {
        titleEn,
        titleBn: titleBn || null,
        descriptionEn: descriptionEn || null,
        descriptionBn: descriptionBn || null,
        date: date ? new Date(date) : null,
        pdfUrl: pdfData.secure_url,
        pdfPublicId: pdfData.public_id,
        previewImgUrl,
        previewImgPublicId,
        sortOrder: nextSortOrder,
      },
    })

    // Invalidate cache so changes appear immediately
    invalidateCache()

    res.json({ success: true, data: item })
  } catch (err) {
    console.error('Failed creating document:', err)
    res.status(500).json({ error: `Failed to create document: ${err.message}` })
  }
})

router.patch('/reorder', async (req, res) => {
  try {
    const { items } = req.body
    if (!Array.isArray(items) || items.length === 0) {
      return res.status(400).json({ error: 'items must be array' })
    }
    if (!items.every((item) => Number.isInteger(Number(item.id)) && Number(item.id) > 0 && Number.isInteger(Number(item.sortOrder)))) {
      return res.status(400).json({ error: 'Each item must have a valid id and sortOrder' })
    }

    const updated = await Promise.all(
      items.map((item) =>
        prisma.document.update({
          where: { id: Number(item.id) },
          data: { sortOrder: Number(item.sortOrder) },
        })
      )
    )

    // Invalidate cache so changes appear immediately
    invalidateCache()

    res.json({ success: true, updated })
  } catch (err) {
    console.error('Failed reordering documents:', err)
    res.status(500).json({ error: 'Failed to reorder documents' })
  }
})

router.patch('/:id', upload.fields([{ name: 'pdf', maxCount: 1 }, { name: 'preview', maxCount: 1 }]), async (req, res) => {
  try {
    const { id } = req.params
    const { titleEn, titleBn, descriptionEn, descriptionBn, date } = req.body
    const pdfFile = req.files?.pdf?.[0]
    const previewFile = req.files?.preview?.[0]

    const existing = await prisma.document.findUnique({ where: { id: Number(id) } })
    if (!existing) return res.status(404).json({ error: 'Document not found' })

    const data = {}
    if (titleEn !== undefined) data.titleEn = titleEn
    if (titleBn !== undefined) data.titleBn = titleBn || null
    if (descriptionEn !== undefined) data.descriptionEn = descriptionEn || null
    if (descriptionBn !== undefined) data.descriptionBn = descriptionBn || null
    if (date !== undefined) data.date = date ? new Date(date) : null

    if (pdfFile) {
      if (existing.pdfPublicId) {
        try { await deleteFromCloudinary(existing.pdfPublicId) } catch (e) { console.warn('Failed deleting old PDF:', e) }
      }
      const pdfData = await uploadToCloudinary(pdfFile.buffer, 'heritage-of-hope/documents', { resourceType: 'raw' })
      data.pdfUrl = pdfData.secure_url
      data.pdfPublicId = pdfData.public_id
    }

    if (previewFile) {
      if (existing.previewImgPublicId) {
        try { await deleteFromCloudinary(existing.previewImgPublicId) } catch (e) { console.warn('Failed deleting old preview:', e) }
      }
      const previewData = await uploadToCloudinary(previewFile.buffer, 'heritage-of-hope/documents/previews', {
        resourceType: 'image',
        transformation: [{ width: 800, crop: 'limit', quality: 'auto:good' }],
      })
      data.previewImgUrl = previewData.secure_url
      data.previewImgPublicId = previewData.public_id
    }

    const item = await prisma.document.update({ where: { id: Number(id) }, data })

    // Invalidate cache so changes appear immediately
    invalidateCache()

    res.json({ success: true, data: item })
  } catch (err) {
    console.error('Failed updating document:', err)
    res.status(500).json({ error: `Failed to update document: ${err.message}` })
  }
})

router.delete('/:id', async (req, res) => {
  try {
    const { id } = req.params
    const item = await prisma.document.findUnique({ where: { id: Number(id) } })
    if (!item) return res.status(404).json({ error: 'Document not found' })

    if (item.pdfPublicId) {
      try { await deleteFromCloudinary(item.pdfPublicId) } catch (e) { console.warn('Failed deleting PDF:', e) }
    }
    if (item.previewImgPublicId) {
      try { await deleteFromCloudinary(item.previewImgPublicId) } catch (e) { console.warn('Failed deleting preview:', e) }
    }

    await prisma.document.delete({ where: { id: Number(id) } })

    // Invalidate cache so changes appear immediately
    invalidateCache()

    res.json({ success: true })
  } catch (err) {
    console.error('Failed deleting document:', err)
    res.status(500).json({ error: `Failed to delete document: ${err.message}` })
  }
})

export default router
